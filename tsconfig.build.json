{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "types": ["node"],
    // Production builds are always full: nest's deleteOutDir + a stale .tsbuildinfo would emit nothing.
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "**/*.test.ts"]
}
