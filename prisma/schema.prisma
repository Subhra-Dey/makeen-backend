// MAKEEN FM Portal — database schema (PostgreSQL 17+).
// Columns mirror the field definitions in src/shared/fields (a test asserts they match).
// Security objects Prisma cannot model (RLS policies, CHECK constraints, triggers, grants) live in
// prisma/migrations/*_security/migration.sql. See docs/ARCHITECTURE.md §5 and DECISIONS D-08.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

