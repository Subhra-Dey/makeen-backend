# MAKEEN FM Portal — API environment (copy to api/.env; `npm run keys:generate` fills __GENERATE__).
# On servers, set these as real environment variables from the secret store. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# ── HTTP ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Public origin of the web app (only allowed CORS origin; cookies are scoped to it).
WEB_ORIGIN=http://localhost:3000
# The web server proxies /api/* to this API. Set to the web server's IP/subnet in production
# so client IPs (throttling, audit log) come from X-Forwarded-For. See docs/DEPLOYMENT.md.
TRUST_PROXY=loopback
SWAGGER_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000

# ── PostgreSQL (17+) ─────────────────────────────────────
# Local Windows Postgres: run `npm run db:bootstrap` — it creates the roles/databases and fills these.
# Docker instead: `npm run infra:up` uses POSTGRES_PASSWORD for the container's owner role.
POSTGRES_PASSWORD=__GENERATE__
# Runtime (non-owner role, row-level security applies)
DATABASE_URL=postgresql://makeen_app:CHANGE_ME@localhost:5432/makeen
# Migrations + seed (schema owner)
MIGRATE_DATABASE_URL=postgresql://makeen_owner:CHANGE_ME@localhost:5432/makeen
# API e2e tests (separate database, wiped by the tests)
TEST_DATABASE_URL=postgresql://makeen_owner:CHANGE_ME@localhost:5432/makeen_test

# ── Redis 8 ──────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE__
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# ── Outbound messages (OTP etc.) ─────────────────────────
# console = DEV ONLY: OTP SMS/email are printed in the API console (refused in production).
EMAIL_PROVIDER=console
# smtp: Mailpit in dev (docker), the company relay in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MAKEEN FM Portal <no-reply@makeenenergy.com>
# console (dev) | msg91 (India, DLT template containing ##OTP##)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── Object storage (S3-compatible; SeaweedFS in dev) ─────
# s3 = SeaweedFS (docker) / the production bucket. local = DEV ONLY folder (refused in production),
# for machines without Docker; files land in STORAGE_LOCAL_DIR (git-ignored).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=http://localhost:8333
S3_REGION=ap-south-1
S3_BUCKET=makeen-files
S3_ACCESS_KEY_ID=makeen-dev
S3_SECRET_ACCESS_KEY=__GENERATE__

# ── Scheduled work ───────────────────────────────────────
# Daily Licence Due/Expired + Audit overdue notices at NOTICE_DAILY_AT (India time) and the email
# outbox (every 15 s). Idempotent, so every API server may run it.
JOBS_ENABLED=true
NOTICE_DAILY_AT=07:00

# ── Authentication ───────────────────────────────────────
# Ed25519 key pair for access tokens (PEM, base64 on one line).
JWT_PRIVATE_KEY_B64=__GENERATE__
JWT_PUBLIC_KEY_B64=__GENERATE__
JWT_ISSUER=makeen-fm-api
JWT_AUDIENCE=makeen-fm-web
ACCESS_TOKEN_TTL_SECONDS=900
# Sliding sessions: idle cap and absolute cap from sign-in (D-07).
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_MAX_DAYS=30
AUTH_CACHE_TTL_SECONDS=60
# Secure cookies (+ __Host-/__Secure- names). Default true in production; false for plain-http dev.
COOKIE_SECURE=false
PASSWORD_PEPPER=__GENERATE__
OTP_PEPPER=__GENERATE__
OTP_TTL_MINUTES=10
AADHAAR_ENC_KEY_B64=__GENERATE__
AADHAAR_ENC_KEY_ID=k1
ALLOWED_EMAIL_DOMAINS=makeenenergy.com

# ── People / KEKA ────────────────────────────────────────
# Set by Admin "Reset to default password". It never opens a session: the person is told to set a
# new password, and does so with OTP from the Login screen (D-72).
RESET_DEFAULT_PASSWORD=__GENERATE__
# KEKA API adapter (PPL-3). Leave empty to use only the CSV / Excel loader. Contract: docs/DEPLOYMENT.md.
KEKA_API_URL=
KEKA_API_TOKEN=
KEKA_API_TIMEOUT_MS=30000

# ── Seed (dev only; refused when NODE_ENV=production) ────
SEED_TODAY=2026-10-16
SEED_DEFAULT_PASSWORD=__GENERATE__
